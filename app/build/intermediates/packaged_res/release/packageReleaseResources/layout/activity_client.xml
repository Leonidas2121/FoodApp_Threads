<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    tools:context=".ClientActivity"
    android:background="@drawable/client_backgound">

    <!-- Επιλέξτε Κατηγορία -->
    <TextView
        android:id="@+id/categoryLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Επιλέξτε Κατηγορία"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingBottom="0dp"
        android:layout_marginBottom="2dp"/>

    <LinearLayout
        android:id="@+id/categoryContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginBottom="2dp">

        <!-- Pizzeria -->
        <FrameLayout
            android:id="@+id/framePizzeria"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="1dp"
            android:foregroundGravity="center">
            <ImageView
                android:id="@+id/imgPizzeria"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_pizzeria"
                android:scaleType="centerCrop"
                android:contentDescription="Pizzeria" />
            <ImageView
                android:id="@+id/checkPizzeria"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_overlay"
                android:visibility="gone" />
        </FrameLayout>
        <!-- Mexican -->
        <FrameLayout
            android:id="@+id/frameMexican"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="1dp"
            android:foregroundGravity="center">
            <ImageView
                android:id="@+id/imgMexican"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_mexican"
                android:scaleType="centerCrop"
                android:contentDescription="Mexican" />
            <ImageView
                android:id="@+id/checkMexican"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_overlay"
                android:visibility="gone" />
        </FrameLayout>
        <!-- Burger -->
        <FrameLayout
            android:id="@+id/frameBurger"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="1dp"
            android:foregroundGravity="center">
            <ImageView
                android:id="@+id/imgBurger"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_burger"
                android:scaleType="centerCrop"
                android:contentDescription="Burger" />
            <ImageView
                android:id="@+id/checkBurger"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_overlay"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Ελάχιστα αστέρια -->
    <TextView
        android:id="@+id/minStarsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ελάχιστα αστέρια"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingBottom="0dp"
        android:layout_marginBottom="2dp"/>

    <RatingBar
        android:id="@+id/minStarsRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="1.0"
        android:rating="0"
        android:scaleX="2.0"
        android:scaleY="2.0"
        style="@style/Widget.AppCompat.RatingBar.Small"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="@color/starGrey"
        android:progressTint="@color/starGold"
        android:secondaryProgressTint="@color/starGold"
        android:isIndicator="false"
        android:layout_marginBottom="3dp"/>

    <TextView
        android:id="@+id/priceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Επιλέξτε Τιμή"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingBottom="0dp"
        android:layout_marginBottom="2dp" />

    <LinearLayout
        android:id="@+id/price_filter_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
    android:layout_marginBottom="2dp">

    <!-- Ομάδα 1: ένα “€” -->
    <LinearLayout
        android:id="@+id/group_price_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="2dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/price_1_1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_euro"
            app:tint="@color/starGrey"
            android:contentDescription="price_single_euro" />
    </LinearLayout>

        <View
            android:layout_width="16dp"
            android:layout_height="0dp" />
    <!-- Ομάδα 2: δύο “€” -->
    <LinearLayout
        android:id="@+id/group_price_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="2dp"
        android:layout_marginEnd="32dp"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/price_2_1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_euro"
            app:tint="@color/starGrey"
            android:contentDescription="price_double_euro_part1" />
        <ImageView
            android:id="@+id/price_2_2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_euro"
            app:tint="@color/starGrey"
            android:contentDescription="price_double_euro_part2" />
    </LinearLayout>

        <View
            android:layout_width="16dp"
            android:layout_height="0dp" />

    <!-- Ομάδα 3: τρία “€” -->
    <LinearLayout
        android:id="@+id/group_price_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"

        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/price_3_1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_euro"
            app:tint="@color/starGrey"
            android:contentDescription="price_triple_euro_part1" />
        <ImageView
            android:id="@+id/price_3_2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_euro"
            app:tint="@color/starGrey"
            android:contentDescription="price_triple_euro_part2" />
        <ImageView
            android:id="@+id/price_3_3"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_euro"
            app:tint="@color/starGrey"
            android:contentDescription="price_triple_euro_part3" />
    </LinearLayout>
</LinearLayout>

    <!-- Συντεταγμένες Latitude & Longitude δίπλα-δίπλα -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lat"
            android:textSize="18sp"
            android:layout_marginEnd="2dp"/>
        <EditText
            android:id="@+id/editLatitude"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:hint="π.χ. 37.98"
            android:inputType="numberDecimal"
            android:textSize="18sp"
            android:padding="0dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lon"
            android:textSize="18sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2dp"/>
        <EditText
            android:id="@+id/editLongitude"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:hint="π.χ. 23.72"
            android:inputType="numberDecimal"
            android:textSize="18sp"
            android:padding="0dp"/>
    </LinearLayout>

    <!-- Κουμπί “Αναζήτηση” -->
    <Button
        android:id="@+id/searchButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backgroundTint="@color/white"
        android:textColor="@color/black"
        android:text="Αναζήτηση"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"/>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="2dp"/>

    <!-- Κουμπί “Back” -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backgroundTint="@color/white"
        android:textColor="@color/black"
        android:text="Back"
        android:layout_marginTop="2dp"/>

</LinearLayout>
