<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/storeLogo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_store"
        android:contentDescription="Store logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/storeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Όνομα καταστήματος"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/storeCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Κατηγορία" />

        <androidx.appcompat.widget.AppCompatRatingBar
            android:id="@+id/storeRating"
            style="?android:attr/ratingBarStyleIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1.0"
            android:isIndicator="true"
            android:layout_marginTop="4dp"

            android:progressTint="@color/starGold"
            android:secondaryProgressTint="@color/starGold"
            android:progressBackgroundTint="@color/starGrey"/>


        <Button
        android:id="@+id/buyButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:backgroundTint="@color/white"
        android:textColor="@color/black"
        android:text="Αγόρασε" />

    </LinearLayout>
</LinearLayout>